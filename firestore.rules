rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User profile collection (creator profiles, avatars, settings)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // 2. Quizzes collection (quizzes, questions, custom theme & styling)
    match /quizzes/{quizId} {
      // Anyone can read a quiz so respondents and guests can take it
      allow read: if true;
      // Only authenticated creators can create quizzes
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      // Creators can update their quizzes; respondents can increment responseCount
      allow update: if (request.auth != null && resource.data.creatorId == request.auth.uid)
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount', 'updatedAt']);
      // Only the creator can delete their quiz
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;

      // Subcollection responses (if any)
      match /responses/{responseId} {
        allow create: if true;
        allow read, delete: if request.auth != null;
        allow update: if false;
      }
    }

    // 3. Top-level responses collection (respondent answers, scores, timestamps)
    match /responses/{responseId} {
      // Anyone can submit quiz/form responses
      allow create: if true;
      // Logged in creators can view responses in dashboard analytics
      allow read: if request.auth != null;
      // Logged in creators can delete response entries
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // 4. Submission verification lock (enforces 1 submission per email)
    match /quiz_submissions/{subId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}

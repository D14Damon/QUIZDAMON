rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Quizzes collection
    match /quizzes/{quizId} {
      // Anyone can read a quiz so respondents can answer it
      allow read: if true;
      // Only authenticated users can create quizzes
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      // Creator can update or delete; respondents can update responseCount
      allow update: if (request.auth != null && resource.data.creatorId == request.auth.uid)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount', 'updatedAt']));
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;

      // Responses subcollection inside quiz
      match /responses/{responseId} {
        allow create: if true;
        allow read, delete: if request.auth != null && get(/databases/$(database)/documents/quizzes/$(quizId)).data.creatorId == request.auth.uid;
        allow update: if false;
      }
    }

    // Top-level responses collection
    match /responses/{responseId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.creatorId == request.auth.uid
      );
      allow update: if false;
    }

    // Submission verification lock (enforcing 1 submission per user)
    match /quiz_submissions/{subId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}

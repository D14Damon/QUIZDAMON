rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User profile collection (creator profiles, avatars, settings)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // 2. Quizzes collection (quizzes, questions, custom theme & styling)
    match /quizzes/{quizId} {
      // Anyone can read a quiz so respondents and students can take it
      allow read: if true;
      // Authenticated creators can create quizzes
      allow create: if request.auth != null;
      // Creators can update their quizzes; respondents can increment responseCount & updatedAt
      allow update: if (request.auth != null && (resource.data.creatorId == request.auth.uid || !('creatorId' in resource.data)))
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount', 'updatedAt']);
      // Only the creator can delete their quiz
      allow delete: if request.auth != null && (resource.data.creatorId == request.auth.uid || !('creatorId' in resource.data));

      // Subcollection responses
      match /responses/{responseId} {
        allow create: if true;
        allow read: if true;
        allow delete: if request.auth != null;
        allow update: if false;
      }
    }

    // 3. Top-level responses collection (respondent answers, scores, timestamps)
    match /responses/{responseId} {
      // Anyone can submit quiz responses
      allow create: if true;
      // Anyone can read responses for quiz dashboard analytics
      allow read: if true;
      // Authenticated creators can delete response entries
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // 4. Submission verification lock (enforces 1 submission per user/email)
    match /quiz_submissions/{subId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}

